NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3001

# Database
DATABASE_URL="postgresql://warung:<GANTI>@localhost:5432/warung?schema=public"

# JWT & Authentication (wajib diisi; minimal 32 karakter)
JWT_SECRET="<GANTI_MINIMAL_32_KARAKTER>"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
JWT_ISSUER="warung-api"
JWT_AUDIENCE="warung-client"

# Security
BCRYPT_ROUNDS=12
REFRESH_TOKEN_ROTATION=true
REFRESH_TOKEN_REUSE_DETECTION=true

# Redis (opsional untuk rate limiting/cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage (upload gambar produk)
STORAGE_DRIVER=local
UPLOAD_MAX_SIZE_MB=5
UPLOAD_DIR=./uploads

# WhatsApp Business API (opsional - Phase 1 bisa kosong)
WA_API_BASE_URL=
WA_API_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=

# Observability
LOG_LEVEL=debug
SENTRY_DSN=

# Seed (hanya untuk development; wajib diisi, jangan gunakan password default)
SEED_ADMIN_PASSWORD=<GANTI>
SEED_CASHIER_PASSWORD=<GANTI>