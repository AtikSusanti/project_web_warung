# ═══════════════════════════════════════════════════════════════════════════════
# APLIKASI WEB WARUNG — Environment Template
# ═══════════════════════════════════════════════════════════════════════════════
# Salin menjadi `.env` di root:  cp .env.example .env
# Nilai bertanda <GANTI> WAJIB diganti sebelum production.
# Jangan pernah commit .env yang sudah berisi nilai asli.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=Asia/Jakarta
LOG_LEVEL=debug
# publicly-exposed base URL, tanpa trailing slash
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=warung
POSTGRES_PASSWORD=<GANTI>
POSTGRES_DB=warung
# Dipakai DATABASE_URL di bawah. Untuk Docker Compose, host = "postgres"
DATABASE_URL=postgresql://warung:<GANTI>@localhost:5432/warung?schema=public&connection_limit=10&pool_timeout=20
# Connection string untuk job migrasi (pg_dump/pg_restore) — tanpa query param
ADMIN_DATABASE_URL=postgresql://warung:<GANTI>@localhost:5432/postgres

# ─── Cache & Queue (opsional — app tetap jalan tanpa Redis, lihat docs/adr) ──
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60
# true = wajib Redis; false = fallback in-memory
REDIS_REQUIRED=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
# WAJIB: minimal 32 karakter. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=<GANTI_MINIMAL_32_KARAKTER>
JWT_REFRESH_SECRET=<GANTI_MINIMAL_32_KARAKTER>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Salt/pepper tambahan untuk password hashing (scrypt)
PASSWORD_PEPPER=<GANTI>
BCRYPT_ROUNDS=12
# Cookie auth untuk SameSite=None (PWA cross-origin). true = pakai cookie, false = header Bearer
USE_COOKIE_AUTH=false
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# ─── Seed admin & kasir awal (dipakai prisma/seed.ts) ──────────
SEED_ADMIN_PASSWORD=<GANTI>
SEED_CASHIER_PASSWORD=<GANTI>

# ─── Object Storage (opsional — fallback ke local disk) ─────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=5
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=warung
S3_ACCESS_KEY_ID=<GANTI>
S3_SECRET_ACCESS_KEY=<GANTI>
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
WA_PHONE_NUMBER=6281234567890
WA_MESSAGE_TEMPLATE=order
WA_BUSINESS_API_TOKEN=
WA_BUSINESS_PHONE_ID=

# ─── Reporting (Phase 1: ringkasan penjualan, SAK EMKM menyusul) ──────────────
REPORT_TIMEZONE=Asia/Jakarta
CURRENCY=IDR

# ─── Security / Rate limit ───────────────────────────────────────────────────
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_PUBLIC=120
RATE_LIMIT_MAX_AUTH=10
TRUST_PROXY_HOPS=1
ENABLE_HELMET=true

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true

# ─── Ops ──────────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=warung-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
LOG_RETENTION_DAYS=14
